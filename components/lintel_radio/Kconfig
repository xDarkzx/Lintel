menu "Lintel LoRa"

    config LINTEL_LORA_FREQ_KHZ
        int "Frequency (kHz)"
        default 917000
        help
            Centre frequency. The default sits in the NZ/AU 915-928 MHz ISM band.

    config LINTEL_LORA_BW_KHZ
        int "Bandwidth (kHz)"
        default 250

    config LINTEL_LORA_SF
        int "Spreading factor"
        range 6 12
        default 7

    config LINTEL_LORA_CR
        int "Coding rate denominator (4/x)"
        range 5 8
        default 5

    config LINTEL_LORA_POWER_DBM
        int "TX power (dBm)"
        range -9 22
        default 14

    config LINTEL_LORA_PREAMBLE
        int "Preamble length (symbols)"
        default 12

    config LINTEL_LORA_SCK
        int "SPI SCK GPIO"
        default 9
    config LINTEL_LORA_MISO
        int "SPI MISO GPIO"
        default 11
    config LINTEL_LORA_MOSI
        int "SPI MOSI GPIO"
        default 10
    config LINTEL_LORA_NSS
        int "NSS GPIO"
        default 8
    config LINTEL_LORA_RST
        int "RESET GPIO"
        default 12
    config LINTEL_LORA_BUSY
        int "BUSY GPIO"
        default 13
    config LINTEL_LORA_DIO1
        int "DIO1 GPIO"
        default 14

    config LINTEL_LORA_TCXO_MV
        int "TCXO voltage on DIO3 (mV, 0 = crystal)"
        default 1800

    config LINTEL_LORA_DIO2_RF_SWITCH
        bool "DIO2 drives the RF switch"
        default y

endmenu
